+test("native agent relay retries an account-rejected model and reuses the accepted model", async () => {
+  const nativeModels = [];
+  const native = await mockServer(async (request, response) => {
+    const body = await bodyJson(request);
+    nativeModels.push(body.model);
+    if (body.model === "gpt-6-luna") {
+      json(response, 400, {
+        detail: "The 'gpt-6-luna' model is not supported when using Codex with a ChatGPT account.",
+      });
+      return;
+    }
+    const payload = JSON.stringify({ payload: "Review only this change." });
+    response.writeHead(200, { "Content-Type": "text/event-stream" });
+    response.end(
+      `data: ${JSON.stringify({
+        type: "response.output_item.done",
+        item: { type: "function_call", name: "relay_external_agent_payload", arguments: payload },
+      })}\n\ndata: [DONE]\n\n`,
+    );
+  });
+  const gatewayRequests = [];
+  const gateway = await mockServer(async (request, response) => {
+    gatewayRequests.push(await bodyJson(request));
+    json(response, 200, { route: "external" });
+  });
+  const routerPort = await openPort();
+  const router = run("router.mjs", {
+    CODEX_ROUTER_PORT: String(routerPort),
+    CODEX_NATIVE_BASE_URL: `http://127.0.0.1:${native.port}/backend-api/codex`,
+    CODEX_ROUTER_GATEWAY_BASE_URL: `http://127.0.0.1:${gateway.port}/v1`,
+    CODEX_ROUTER_QUIET: "1",
+  });
+
+  const relay = (ciphertext, account = "account-id") => fetch(`${routerBase(routerPort)}/responses`, {
+    method: "POST",
+    headers: {
+      Authorization: "Bearer test-session",
+      "ChatGPT-Account-Id": account,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({
+      model: "kimi-oauth/k3",
+      input: [{
+        type: "agent_message",
+        content: [
+          { type: "input_text", text: "Message Type: NEW_TASK\nPayload:\n" },
+          { type: "encrypted_content", encrypted_content: ciphertext },
+        ],
+      }],
+    }),
+  });
+
+  try {
+    await waitFor(`${routerBase(routerPort)}/models`, router);
+    const first = await relay("gAAAAA-first-payload=");
+    assert.equal(first.status, 200, await first.text());
+    const second = await relay("gAAAAA-second-payload=");
+    assert.equal(second.status, 200, await second.text());
+    const otherAccount = await relay("gAAAAA-third-payload=", "other-account");
+    assert.equal(otherAccount.status, 200, await otherAccount.text());
+    assert.deepEqual(nativeModels, [
+      "gpt-6-luna", "gpt-5.6-luna", "gpt-5.6-luna", "gpt-6-luna", "gpt-5.6-luna",
+    ]);
+    assert.equal(gatewayRequests.length, 3);
+    for (const body of gatewayRequests) {
+      assert.equal(body.input[0].content.at(-1).text, "Review only this change.");
+      assert.equal(body.input[0].content.some((part) => part.type === "encrypted_content"), false);
+    }
+    assert.doesNotMatch(router.testErrors(), /Review only this change|gAAAAA-first-payload/u);
+  } finally {
+    await stopChild(router);
+    await Promise.all([closeServer(native.server), closeServer(gateway.server)]);
+  }
+});
+
